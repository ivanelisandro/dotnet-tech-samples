@page "/counter"
@using BasicSample.Components

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<IncrementButton IncrementValue="1" OnIncremented="HandleIncrement" />
<IncrementButton IncrementValue="10" OnIncremented="HandleIncrement" />
<IncrementButton IncrementValue="0.1m" OnIncremented="HandleIncrement" />

@code {
    private decimal currentCount = 0;

    /// <summary>
    /// Handles operations with the counter for an increment reported.
    /// </summary>
    /// <param name="incrementValue">The value to increase the counter.</param>
    private void HandleIncrement(decimal incrementValue)
    {
        currentCount += incrementValue;
        StateHasChanged();
    }
}
