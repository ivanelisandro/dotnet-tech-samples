@using RoutingSample.Models

<ul>
    @foreach (var (id, recipeName) in Recipes)
    {
        <li style="padding: 0.3vh 0.2vw">
            <strong>@recipeName</strong>
            <br />
            <NavLink class="btn btn-primary"
                     href="@($"/recipes/{id}")"
                     Match="NavLinkMatch.Prefix">View Details
            </NavLink>
        </li>
    }
</ul>

@code {
    [Parameter]
    public Dictionary<int, string> Recipes { get; set; }
}
