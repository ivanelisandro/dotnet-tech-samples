@using BasicSampleUI.Services
@inject ProductsService ProductsService
@page "/products"

<h3>Products</h3>
@if (products == null)
{
    <p>Loading...</p>
    return;
}


<ul>
    @foreach (var product in products)
    {
        <li>@product.Name</li>
    }
</ul>

@code {
    private IEnumerable<Product>? products;

    /// <summary>
    /// Sets up required states when the page is initialized.
    /// </summary>
    /// <returns>The Task representing the result of the asynchronous operation.</returns>
    protected override async Task OnInitializedAsync()
    {
        products = await ProductsService.GetAllAsync();
    }
}
